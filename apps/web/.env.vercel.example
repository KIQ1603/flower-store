# ===== FRONTEND (React + Vite) trên Vercel =====
# Cách dùng: Vercel → Project → Settings → Environment Variables, thêm từng biến dưới đây (Production).
# Biến VITE_* được nhúng vào mã web khi BUILD và ai cũng đọc được → chỉ để thông tin công khai, KHÔNG để khoá bí mật.
# Đổi biến xong phải Redeploy mới có hiệu lực.
#
# Cài đặt project trên Vercel:
#   Framework Preset : Vite
#   Root Directory   : apps/web
#   Build Command    : npm run build
#   Output Directory : dist
# (vercel.json trong apps/web đã có sẵn luật đưa mọi đường dẫn về index.html cho React Router)

# Địa chỉ API trên Render, có đuôi /api/v1, KHÔNG có dấu / ở cuối
VITE_API_URL=https://ten-api.onrender.com/api/v1

# (Tuỳ chọn) CDN thu nhỏ ảnh. Để trống nếu không dùng, ảnh vẫn hiện bình thường
VITE_IMG_CDN=
