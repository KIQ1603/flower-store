{
  "name": "florea-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:render": "prisma migrate deploy && ts-node prisma/seed.ts && node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9",
    "typescript-eslint": "^8.73.0"
  }
}
