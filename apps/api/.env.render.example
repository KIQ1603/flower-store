# ===== BACKEND (NestJS) trên Render =====
# Cách dùng: Render → service API → Environment → "Add from .env" rồi dán nội dung (đã điền) vào.
# KHÔNG commit tệp đã điền giá trị thật. Tạo chuỗi ngẫu nhiên: openssl rand -base64 48
#
# Cài đặt service trên Render (Web Service, Runtime = Node):
#   Root Directory : apps/api
#   Build Command  : npm ci --include=dev && npx prisma generate && npm run build
#                    (--include=dev bắt buộc: Render đặt NODE_ENV=production nên mặc định bỏ gói build/ts-node)
#   Start Command  : npm run start:render
#                    (= migrate deploy + nạp dữ liệu mẫu + chạy API; nạp mẫu chạy lặp lại an toàn, KHÔNG ghi đè dữ liệu admin đã sửa.
#                     Nếu dùng gói có Pre-Deploy Command thì có thể tách: Pre-Deploy = "npx prisma migrate deploy && npx ts-node prisma/seed.ts", Start = "node dist/main.js")
#   Health Check   : /api/v1/health
# Database: tạo "Render Postgres", dán Internal Database URL vào DATABASE_URL.

NODE_ENV=production
PORT=10000
TRUST_PROXY=1

# --- Cơ sở dữ liệu ---
DATABASE_URL=

# --- Khoá đăng nhập (mỗi khoá ≥ 32 ký tự, ngẫu nhiên, KHÁC nhau) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Địa chỉ web (Vercel). CORS_ORIGINS có thể nhiều domain, cách nhau dấu phẩy, KHÔNG có dấu / ở cuối ---
CORS_ORIGINS=https://ten-du-an.vercel.app
WEB_URL=https://ten-du-an.vercel.app

# --- Tài khoản quản trị: tự tạo ở lần chạy đầu. Đặt mật khẩu mạnh, khác Admin@123456 ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Nhận email cảnh báo khi API lỗi 5xx
ALERT_EMAIL=

# --- Dữ liệu mẫu để thử ngay sau khi deploy (nạp tự động khi khởi động) ---
# Gồm: 1 admin (ở trên) + 1 khách mẫu, 3 tỉnh/15 phường, 8 hoa + 12 sản phẩm chăm sóc, 3 mẫu thiệp, 3 bài viết, mã FLORAx5.
# Khách mẫu chỉ được tạo khi có DEMO_USER_PASSWORD (đặt mật khẩu mạnh, không dùng mật khẩu công khai).
DEMO_USER_EMAIL=khach@florahub.vn
DEMO_USER_PASSWORD=
# SEED_RESET=1   (CHỈ khi muốn đưa sản phẩm/bài viết về mẫu ban đầu; sẽ ghi đè phần admin đã sửa)
# SEED_DEMO=off  (bỏ khách mẫu và thiệp mẫu)

# --- Gửi email OTP/thông báo (SMTP thật) ---
# Resend: host smtp.resend.com, cổng 465, user "resend", pass = API key. Cần xác minh domain gửi thư.
# Lưu ý: gói Free của Render CHẶN cổng SMTP đi ra (25/465/587) → cần gói trả phí, hoặc đổi nhà cung cấp cho phép.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Florea <no-reply@ten-mien-cua-ban.vn>

# --- Đăng nhập Google (chỉ cần Client ID, KHÔNG dùng Client Secret). Thêm domain Vercel vào "Authorized JavaScript origins" ---
GOOGLE_CLIENT_ID=

# --- Lưu ảnh: Cloudflare R2 (S3 API) ---
# S3_ENDPOINT dạng https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET: bucket CÔNG KHAI (ảnh sản phẩm, đánh giá). S3_PRIVATE_BUCKET: bucket RIÊNG TƯ, khác bucket trên (ảnh xem trước đơn)
# PUBLIC_STORAGE_URL: domain công khai của bucket công khai, VD https://cdn.ten-mien.vn (không có dấu / cuối)
# Bucket cần bật CORS cho phép PUT từ domain web (Vercel) để khách/admin tải ảnh lên.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_STORAGE_URL=

# --- Tuỳ chọn ---
PREVIEW_EXPIRE_MIN=90
# SWAGGER=off   (production mặc định đã tắt)
# RATE_LIMIT=   (để trống = bật giới hạn tần suất; KHÔNG đặt "off" khi chạy thật)
