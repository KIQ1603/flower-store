# Sao chép thành .env.production rồi điền giá trị thật. KHÔNG commit tệp .env.production.
DOMAIN=florea.vn                      # domain thật → Caddy tự cấp HTTPS (để trống = chạy HTTP cổng 80)
CORS_ORIGINS=https://florea.vn        # web cùng domain thì chỉ cần domain này

POSTGRES_PASSWORD=                    # mật khẩu mạnh, ngẫu nhiên
JWT_ACCESS_SECRET=                    # ≥32 ký tự ngẫu nhiên:  openssl rand -hex 32
JWT_REFRESH_SECRET=                   # khác với khoá trên:      openssl rand -hex 32

ADMIN_EMAIL=admin@florea.vn           # tài khoản quản trị tạo ở lần chạy đầu tiên
ADMIN_PASSWORD=                       # đổi khác mật khẩu mặc định
ALERT_EMAIL=                          # người nhận cảnh báo lỗi 5xx

# SMTP thật để gửi OTP/thông báo (Resend: smtp.resend.com, cổng 465, user "resend", pass = API key; SES: email-smtp.<vùng>.amazonaws.com)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Florea <no-reply@florea.vn>"

GOOGLE_CLIENT_ID=                     # OAuth Client ID (Google Cloud Console), để trống nếu chưa dùng đăng nhập Google

# Cloudflare R2 (S3 API). PUBLIC_STORAGE_URL là domain công khai của bucket (products/*, reviews/*)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=florea                      # bucket CÔNG KHAI (ảnh sản phẩm, ảnh đánh giá)
S3_PRIVATE_BUCKET=florea-private      # bucket RIÊNG TƯ, KHÔNG bật public (ảnh xem trước bó hoa trước khi giao)
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_STORAGE_URL=https://img.florea.vn
VITE_IMG_CDN=                         # (tuỳ chọn) domain bật Cloudflare Image Resizing, VD https://florea.vn để ảnh tự thu nhỏ theo màn hình

BACKUP_KEEP_DAYS=14
